{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "ebbab8ee-6ab3-4984-9273-a898e517aa10"
  },
  "newProjectRoot": "projects",
  "projects": {
    "catalogo-ny": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "index": "index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/fonts",
                "output": "assets/fonts"
              },
              {
                "glob": "**/*",
                "input": "src/assets/products",
                "output": "assets/products"
              },
              {
                "glob": "**/*",
                "input": "src/assets/ui",
                "output": "assets/ui"
              },
              {
                "glob": "catalog-image-manifest.json",
                "input": "data",
                "output": "data"
              }
            ],
            "styles": [
              "src/styles.scss",
              "src/assets/css/fonts.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "catalogo-ny:build:production"
            },
            "development": {
              "buildTarget": "catalogo-ny:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
