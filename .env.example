# General WhatsApp number (digits, with country code). Used for product enquiries; if empty,
# product enquiries get one button per branch below.
VITE_WHATSAPP_NUMBER=
# Per-branch numbers (store cards). A branch without one falls back to the general number.
VITE_WHATSAPP_BENTO=
VITE_WHATSAPP_DUQUE=
VITE_WHATSAPP_MATRIZ=
# Base URL of the Estoque API (serves GET /public/catalog). Empty = static catalog only.
VITE_API_URL=
# Optional URL that receives a small JSON beacon when the site had to use the bundled
# catalog because the API failed (wire it to an alerting service to watch the fallback rate).
VITE_FALLBACK_REPORT_URL=

# Build time: `npm run build` refreshes data/catalog-snapshot.json from this API (falls back to
# VITE_API_URL). If it is unreachable the build still passes and keeps the committed snapshot.
# Use `node scripts/snapshot-catalog.cjs --require` in a release build to fail instead.
CATALOG_API_URL=

# Sentry error reporting. Empty = disabled (nothing is loaded or sent).
VITE_SENTRY_DSN=
# Optional release tag; defaults at build time to Vercel's VERCEL_GIT_COMMIT_SHA.
VITE_SENTRY_RELEASE=

# Public origin of the site (no trailing slash). Used by the product-page prerender for og:url,
# og:image and canonical. Falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# Plausible analytics (cookieless). Empty = no analytics script is ever loaded.
VITE_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible origin (default https://plausible.io).
VITE_PLAUSIBLE_HOST=
